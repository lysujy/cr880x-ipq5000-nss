#!/bin/sh
# First-boot customizations for ipq50xx-openwrt-nss.
# Runs once on first boot (the uci-defaults mechanism removes this file
# afterwards). No set -e: a failed step must not abort the rest.

# --- TCP BBR as the default congestion control ---
# Kernel-config default does not survive defconfig on this tree, so set
# it here: persist in sysctl.conf for every boot, and apply live now
# (the tcp_bbr module is already loaded via modules.d by this point).
grep -q '^net.ipv4.tcp_congestion_control=bbr$' /etc/sysctl.conf 2>/dev/null || \
  echo 'net.ipv4.tcp_congestion_control=bbr' >> /etc/sysctl.conf
sysctl -w net.ipv4.tcp_congestion_control=bbr >/dev/null 2>&1

# --- Bootstrap as the default LuCI theme (top menu, not left sidebar) ---
# Argon draws its menu as a left sidebar; Bootstrap lays the same menu out
# as a horizontal bar across the top, which is what we want. Both themes
# ship in the image, so this stays switchable in LuCI under
# System -> System -> "Language and Style".
uci set luci.main.mediaurlbase='/luci-static/bootstrap'
uci commit luci

# --- Chinese as the default language (2026-11-04) ---
# The luci-i18n-*-zh-cn packages register luci.languages.zh_cn (luci.mk
# builds that key with $(subst -,_,zh-cn)); the language picker stores the
# same key in luci.main.lang, so 'zh_cn' is the value it round-trips.
uci set luci.main.lang='zh_cn'
uci commit luci

# --- Identity in the LuCI header / DHCP / SSH prompt (2026-11-04) ---
# The base image ships hostname=OpenWrt, timezone=UTC; set something that
# actually identifies this box and puts the clock on Beijing time.
uci set system.@system[0].hostname='CR8806'
uci set system.@system[0].description='Xiaomi CR8806 M79 - OpenWrt NSS 12.5'
uci set system.@system[0].timezone='CST-8'
uci set system.@system[0].zonename='Asia/Shanghai'
uci commit system

# --- DNS hijack: redirect all LAN TCP/UDP 53 traffic to the router ---
# This forces clients with hardcoded DNS (e.g. 8.8.8.8) through the
# router's resolver (dnsmasq), so caching applies to them.
lan_ip=$(uci -q get network.lan.ipaddr)
[ -n "$lan_ip" ] || lan_ip='192.168.1.1'
uci add firewall redirect >/dev/null 2>&1
uci set firewall.@redirect[-1].name='DNS Hijack'
uci set firewall.@redirect[-1].src='lan'
uci set firewall.@redirect[-1].dest='lan'
uci set firewall.@redirect[-1].proto='tcp udp'
uci set firewall.@redirect[-1].src_dport='53'
uci set firewall.@redirect[-1].dest_ip="$lan_ip"
uci set firewall.@redirect[-1].dest_port='53'
uci set firewall.@redirect[-1].target='DNAT'
uci commit firewall

# --- dnsmasq cache size (switched from SmartDNS 2026-11-03) ---
# dnsmasq is the default resolver. Raise its cache from the 150-entry
# default so repeated queries are answered locally; 1000 entries cost
# only tens of KB of RAM. Restart to apply (first boot only).
uci set dhcp.@dnsmasq[0].cachesize='1000'
uci commit dhcp
/etc/init.d/dnsmasq restart >/dev/null 2>&1
/etc/init.d/firewall reload >/dev/null 2>&1

exit 0
